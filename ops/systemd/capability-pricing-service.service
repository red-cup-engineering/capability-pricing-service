[Unit]
Description=Red Cup capability pricing service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/.local/share/561-group/releases/capability-pricing-service/current
Environment=HOST=127.0.0.1
Environment=PORT=19960
Environment=PRICE_OBSERVATIONS_PATH=/home/emsenn/.local/state/561-group/capability-pricing-service/observations.jsonl
ExecStart=/usr/bin/node bin/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
